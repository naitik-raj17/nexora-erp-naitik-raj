# Copy to .env and adjust. Never commit .env.

# Database (PostgreSQL 17: Docker locally, Neon in production)
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora?schema=public

# Session cookie encryption (at least 32 characters). Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# App
APP_URL=http://localhost:3000

# Integration tests (Vitest) use a separate database; created automatically if missing
TEST_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_test?schema=public
